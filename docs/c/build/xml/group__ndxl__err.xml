      <memberdef kind="function" id="group__ndxl__err_1ga7ed0ec0987f06de2cc78458f0f150002" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>const char *const</type>
        <definition>const char *const ndxlGetLastErrorMsg</definition>
        <argsstring>()</argsstring>
        <name>ndxlGetLastErrorMsg</name>
        <briefdescription>
<para>Gets the most recently raised error message. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>Returns the most recently raised error message. If no error has been raised, returns the default initialisation message.</para>
</simplesect>
<simplesect kind="note"><para>This function is most commonly used in conjunction with ndxlGetLastErrorCode for a full error description. All error messages end in a fullstop.</para>
</simplesect>
<simplesect kind="warning"><para>The char pointer returned is shared, meaning it will be invalidated if another error is raised. The user must explicitly copy the message contents if they want to preserve the message, however, this is not the intended use for the function.</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__ndxl__err_1ga431ccb893f54f2ce7fe5ead2a8abd3cf" kindref="member">ndxlGetLastErrorCode</ref> </para>
</simplesect>
</para>
        </detaileddescription>
