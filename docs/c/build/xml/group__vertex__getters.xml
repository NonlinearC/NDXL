</listitem><listitem><para><ref refid="group__ndxl__err_1gaf6b8bdcb87bdd7944810152b510101e4" kindref="member">NDXL_ARG_ERR</ref> : _Neighbours is NULL.</para>
</listitem></itemizedlist>
</para>
