<codeline><highlight class="normal"><sp/><sp/>unixstatic<sp/>[label=&quot;Static/&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>unixdynamic<sp/>[label=&quot;Dynamic/&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>macosstatic<sp/>[label=&quot;Static/&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>macosdynamic<sp/>[label=&quot;Dynamic/&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>node<sp/>[shape=note,<sp/>fillcolor=&quot;#ffffff&quot;];</highlight></codeline>
