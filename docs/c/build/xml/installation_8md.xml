<codeline><highlight class="normal"><sp/><sp/>unicppheaders<sp/>[label=&quot;...&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>x64lib<sp/>[label=&quot;NDXL.lib&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>x64lib2<sp/>[label=&quot;NDXL.lib&quot;];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>x64dll<sp/>[label=&quot;NDXL.dll&quot;];</highlight></codeline>
