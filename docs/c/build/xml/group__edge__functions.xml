      <memberdef kind="function" id="group__edge__functions_1ga0b8991772645a59dd9e72d5fadd9dc88" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>const char</type>
        <definition>const char ndxlEdgeConnectsVertex</definition>
        <argsstring>(NDXLEdge *_Edge, NDXLVertex *_Vertex)</argsstring>
        <name>ndxlEdgeConnectsVertex</name>
        <param>
          <type><ref refid="ndxlcore_8h_1aa30ac2f40da4dbe7d841088a78f957fe" kindref="member">NDXLEdge</ref> *</type>
          <declname>_Edge</declname>
        </param>
        <param>
          <type><ref refid="ndxlcore_8h_1ad03a49b11a22416ba63273c4d7deb38b" kindref="member">NDXLVertex</ref> *</type>
          <declname>_Vertex</declname>
        </param>
        <briefdescription>
<para>Checks if an edge is connected to a vertex. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">_Edge</parametername>
</parameternamelist>
<parameterdescription>
<para>Target edge to query for vertex connectivity.</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">_Vertex</parametername>
</parameternamelist>
<parameterdescription>
<para>The vertex to determine if _Edge is connected to.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>If either _Edge or _Vertex are NULL, returns <ref refid="group__ndxl__err_1gae9261a8e1c9a6cebdc947ee5798cca1e" kindref="member">NDXL_ERR</ref>, otherwise returns a bitmask detailing the connection of _Edge to _Vertex:<itemizedlist>
<listitem><para>0, if _Edge is not connected to _Vertex.</para>
</listitem><listitem><para>1 (bit 0), if _Edge is connected to _Vertex.</para>
</listitem><listitem><para>3 (bits 0 and 1), if _Edge is directed and _Vertex is the <computeroutput>source</computeroutput> vertex.</para>
</listitem><listitem><para>5 (bits 0 and 2), if _Edge is directed and _Vertex is the <computeroutput>destination</computeroutput> vertex.</para>
</listitem><listitem><para>7 (bits 0, 1, and 2) if _Edge is a self-loop.</para>
</listitem></itemizedlist>
</para>
</simplesect>
<simplesect kind="par"><title>Errors raised</title><para><itemizedlist>
<listitem><para><ref refid="group__ndxl__err_1gaf6b8bdcb87bdd7944810152b510101e4" kindref="member">NDXL_ARG_ERR</ref> : _Edge is NULL.</para>
</listitem><listitem><para><ref refid="group__ndxl__err_1gaf6b8bdcb87bdd7944810152b510101e4" kindref="member">NDXL_ARG_ERR</ref> : _Vertex is NULL.</para>
</listitem></itemizedlist>
</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__edge__creation_1ga64a610b6a899977bbf5722ca30f92114" kindref="member">ndxlCreateEdge</ref> </para>
</simplesect>
</para>
        </detaileddescription>
