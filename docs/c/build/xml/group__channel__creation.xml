  <compounddef id="group__channel__creation" kind="group">
    <compoundname>channel_creation</compoundname>
    <title>Constructor and Destructor</title>
    <sectiondef kind="func">
      <memberdef kind="function" id="group__channel__creation_1ga04594c5bf238b9ec6de0420a44701ed6" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="ndxlcore_8h_1a40b73c1a687ab1376515b42d4294c079" kindref="member">NDXLChannel</ref> *</type>
        <definition>NDXLChannel * ndxlCreateChannel</definition>
        <argsstring>(NDXLNetwork *_Network, void *_Params)</argsstring>
        <name>ndxlCreateChannel</name>
        <param>
          <type><ref refid="group__ndxl__objects_1gaefd105209efdd9f61bea4c3f76770d37" kindref="member">NDXLNetwork</ref> *</type>
          <declname>_Network</declname>
        </param>
        <param>
          <type>void *</type>
          <declname>_Params</declname>
        </param>
        <briefdescription>
<para>Creates a noise channel in a network and returns a pointer to it. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">_Network</parametername>
</parameternamelist>
<parameterdescription>
<para>Network that will own this channel. This also dictates which vertices and edges can be affected by this channel.</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">_Params</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to extra memory used by the channel. May be NULL.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>If _Network is NULL, returns NULL, otherwise returns a new <ref refid="ndxlcore_8h_1a40b73c1a687ab1376515b42d4294c079" kindref="member">NDXLChannel</ref> pointer.</para>
</simplesect>
<simplesect kind="note"><para>Each channel maintains its own Wiener path for use in rejection sampling with memory (RSwM) algorithms. Destroying one while it is in use may disrupt path preservation and intdoduce statistical bias. See <ref refid="group__channel__creation_1ga460edf2e9eeda2afae0f4a8fcf804f83" kindref="member">ndxlDestroyChannel()</ref> for further details.</para>
</simplesect>
<simplesect kind="warning"><para>NDXL stores the supplied <computeroutput>void* _Params</computeroutput> pointer without copying the associated data or managing its lifetime. The pointed-to memory must remain valid for as long as the channel uses it. The user remains responsible for managing any allocations.</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__channel__creation_1ga460edf2e9eeda2afae0f4a8fcf804f83" kindref="member">ndxlDestroyChannel</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__channel__getters_1gae2a14deb284d756f55511e25fb57d48c" kindref="member">ndxlGetChannelEdgeCount</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__channel__getters_1ga0fd0973e5840d882d2cc752e2b011aff" kindref="member">ndxlGetChannelVertexCount</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__vertex__creation_1gaec4b6881830464281fc35817e96bfaf3" kindref="member">ndxlCreateVertex</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__edge__creation_1ga64a610b6a899977bbf5722ca30f92114" kindref="member">ndxlCreateEdge</ref> </para>
</simplesect>
</para>
        </detaileddescription>
