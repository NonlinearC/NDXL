<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Prey<sp/>equation</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>dN[0]<sp/>=<sp/>alpha<sp/>*<sp/>N[0]<sp/>-<sp/>beta<sp/>*<sp/>N[0]<sp/>*<sp/>N[1];</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
